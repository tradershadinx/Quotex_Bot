(()=>{

if(window.__TRADER_SHADIN_X_ACTIVE__)
  return console.warn("Trader Shadin X already running.");

window.__TRADER_SHADIN_X_ACTIVE__=1;

const LOGO="data:image/webp;base64,";

const KEY="trader_shadin_x_settings_v8";
const DEF={delaySec:0,direction:"random"};

let S={...DEF};

try{
 S={...DEF,...JSON.parse(localStorage.getItem(KEY)||"{}")};
}catch{}

S.delaySec=Math.max(0,Math.min(30,+S.delaySec||0));

if(!["up","down","random"].includes(S.direction))
 S.direction="random";

/* REMOVE OLD */

document.getElementById("tsx")?.remove();
document.getElementById("ov")?.remove();
document.getElementById("bd")?.remove();
document.getElementById("p")?.remove();
document.getElementById("tsxStyle")?.remove();

/* CSS */

const st=document.createElement("style");
st.id="tsxStyle";

st.textContent=`

#tsx{
 position:fixed;
 z-index:2147483647;
 left:16px;
 top:50%;
 transform:translateY(-50%);
 display:flex;
 flex-direction:column;
 align-items:center;
 gap:4px;
 cursor:grab;
 user-select:none;
 -webkit-user-select:none;
 touch-action:none;
 filter:drop-shadow(0 2px 6px #000);
}

#tsx:active{
 cursor:grabbing;
}

#tsx img{
 width:48px;
 height:48px;
 border-radius:50%;
 object-fit:cover;
 display:block;
 pointer-events:none;
 image-rendering:auto;
}

#tsx b{
 font:700 10px system-ui,sans-serif;
 color:#fff;
 white-space:nowrap;
 text-shadow:0 1px 3px #000;
 pointer-events:none;
}

#ov{
 position:fixed;
 inset:0;
 z-index:2147483646;
 display:none;
 pointer-events:none;
}

#ov.on{
 display:block;
}

#ln{
 position:absolute;
 left:0;
 top:-8%;
 width:100%;
 height:6px;
 border-radius:10px;
 background:#a855f7;
 box-shadow:
  0 0 12px #a855f7,
  0 0 25px #a855f7,
  0 0 45px #7c3aed,
  0 0 65px #6d28d9;
 opacity:1;
}

#ln.go{
 animation:tsxLine 1.2s linear;
}

@keyframes tsxLine{
 from{top:-8%}
 to{top:108%}
}

#bd{
 position:fixed;
 inset:0;
 z-index:2147483647;
 background:#0008;
 display:none;
}

#bd.on{
 display:block;
}

#p{
 position:fixed;
 z-index:2147483648;
 left:50%;
 top:50%;
 transform:translate(-50%,-50%);
 width:min(300px,calc(100vw - 32px));
 padding:16px;
 border-radius:14px;
 background:#100b16;
 color:#fff;
 border:1px solid #9400ff;
 display:none;
 font:14px system-ui,sans-serif;
 box-shadow:0 10px 40px #000;
}

#p.on{
 display:block;
}

#p h3{
 text-align:center;
 color:#b066ff;
 margin:0 0 14px;
}

#p label{
 display:block;
 margin-top:8px;
}

#p input,
#p button{
 box-sizing:border-box;
 width:100%;
 padding:10px;
 margin:5px 0;
 border-radius:8px;
 border:1px solid #5d2780;
 background:#18101f;
 color:#fff;
 font:inherit;
}

#p button{
 cursor:pointer;
}

#p button.sel{
 border-color:#b066ff;
 background:#3b1654;
}

`;

document.head.appendChild(st);

/* LINE */

const ov=document.createElement("div");
ov.id="ov";

ov.innerHTML='<div id="ln"></div>';

document.body.appendChild(ov);

const ln=ov.querySelector("#ln");

/* BACKDROP */

const bd=document.createElement("div");
bd.id="bd";

document.body.appendChild(bd);

/* SETTINGS */

const p=document.createElement("div");
p.id="p";

p.innerHTML=`

<h3>Trader Shadin X Settings</h3>

<label>Start delay (seconds)</label>

<input
 id="d"
 type="number"
 min="0"
 max="30"
 step="1"
>

<label>Trade direction</label>

<button data-x="up">Up</button>
<button data-x="down">Down</button>
<button data-x="random">Random</button>

<button id="save">Save</button>

`;

document.body.appendChild(p);

/* ICON */

const w=document.createElement("div");
w.id="tsx";

w.innerHTML=`
<img src="${LOGO}" draggable="false">
<b>Trader Shadin X</b>
`;

document.body.appendChild(w);

/* VARIABLES */

const d=p.querySelector("#d");
const bs=p.querySelectorAll("[data-x]");

let taps=0;
let last=0;
let timer=null;
let active=0;
let drag=0;
let moved=0;

let sx=0;
let sy=0;
let sl=0;
let stp=0;

let mt=null;

/* UI */

function ui(){

 d.value=S.delaySec;

 bs.forEach(b=>{
  b.classList.toggle(
   "sel",
   b.dataset.x===S.direction
  );
 });

}

/* CLOSE */

function close(){

 p.classList.remove("on");
 bd.classList.remove("on");

}

/* SAVE */

function save(){

 S.delaySec=Math.max(
  0,
  Math.min(
   30,
   Math.round(+d.value||0)
  )
 );

 S.direction=
  [...bs].find(
   b=>b.classList.contains("sel")
  )?.dataset.x||"random";

 try{
  localStorage.setItem(
   KEY,
   JSON.stringify(S)
  );
 }catch{}

 close();
 ui();

}

/* SETTINGS BUTTONS */

bs.forEach(b=>{

 b.onclick=e=>{

  e.stopPropagation();

  bs.forEach(x=>{
   x.classList.remove("sel");
  });

  b.classList.add("sel");

 };

});

p.querySelector("#save").onclick=e=>{
 e.stopPropagation();
 save();
};

bd.onclick=close;

ui();

/* TRADE BUTTONS */

function buttons(){

 const r=document.getElementById("trade-button");

 if(!r)return[];

 return[
  r.querySelector("button.JQZcs"),
  r.querySelector("button.twQq3")
 ];

}

/* TRADE */

function trade(){

 const [up,down]=buttons();

 const pool=[up,down].filter(Boolean);

 if(!pool.length){

  console.warn(
   "Trader Shadin X: trade buttons not found."
  );

  return;
 }

 let a;

 if(S.direction==="up")
  a=up;

 else if(S.direction==="down")
  a=down;

 else
  a=pool[
   Math.floor(
    Math.random()*pool.length
   )
  ];

 a?.click();

}

/* STOP */

function stop(){

 active=0;

 ov.classList.remove("on");

 ln.classList.remove("go");

 clearTimeout(mt);

 mt=null;

}

/* START */

function start(){

 if(active)return;

 active=1;

 ov.classList.add("on");

 let n=0;

 mt=setTimeout(function f(){

  if(!active)return;

  if(n<3){

   ln.classList.remove("go");

   void ln.offsetWidth;

   ln.classList.add("go");

   n++;

   mt=setTimeout(
    f,
    1200
   );

  }else{

   trade();

   stop();

  }

 },S.delaySec*1000);

}

/* TAP */

function tap(){

 if(p.classList.contains("on"))
  return;

 const n=Date.now();

 if(n-last>600)
  taps=0;

 last=n;

 taps++;

 clearTimeout(timer);

 if(taps>=3){

  taps=0;

  ui();

  p.classList.add("on");
  bd.classList.add("on");

  return;

 }

 timer=setTimeout(()=>{

  if(taps===1){

   if(active)
    stop();
   else
    start();

  }

  taps=0;

 },220);

}

/* POSITION */

function pos(x,y){

 const r=w.getBoundingClientRect();

 const l=Math.max(
  0,
  Math.min(
   sl+x-sx,
   innerWidth-r.width
  )
 );

 const t=Math.max(
  0,
  Math.min(
   stp+y-sy,
   innerHeight-r.height
  )
 );

 w.style.left=l+"px";
 w.style.top=t+"px";
 w.style.transform="none";

}

/* POINTER DOWN */

w.addEventListener(
 "pointerdown",
 e=>{

  if(
   e.pointerType==="mouse" &&
   e.button!==0
  )return;

  e.preventDefault();
  e.stopPropagation();

  drag=1;
  moved=0;

  sx=e.clientX;
  sy=e.clientY;

  const r=w.getBoundingClientRect();

  sl=r.left;
  stp=r.top;

  try{
   w.setPointerCapture(e.pointerId);
  }catch{}

 },
 {passive:false}
);

/* POINTER MOVE */

w.addEventListener(
 "pointermove",
 e=>{

  if(!drag)return;

  e.preventDefault();

  if(
   Math.abs(e.clientX-sx)>8 ||
   Math.abs(e.clientY-sy)>8
  ){
   moved=1;
  }

  if(moved)
   pos(
    e.clientX,
    e.clientY
   );

 },
 {passive:false}
);

/* POINTER UP */

w.addEventListener(
 "pointerup",
 e=>{

  e.preventDefault();
  e.stopPropagation();

  if(!moved)
   tap();

  drag=0;

  try{
   w.releasePointerCapture(
    e.pointerId
   );
  }catch{}

 },
 {passive:false}
);

/* POINTER CANCEL */

w.addEventListener(
 "pointercancel",
 ()=>{
  drag=0;
  moved=0;
 }
);

/* BLOCK CLICK */

w.addEventListener(
 "click",
 e=>{
  e.preventDefault();
  e.stopPropagation();
 }
);

/* GLOBAL STOP */

window.__TRADER_SHADIN_X_STOP__=()=>{

 stop();

 clearTimeout(timer);

 w.remove();
 ov.remove();
 bd.remove();
 p.remove();
 st.remove();

 delete window.__TRADER_SHADIN_X_ACTIVE__;
 delete window.__TRADER_SHADIN_X_STOP__;

};

console.log(
 "Trader Shadin X loaded - Purple Only Line"
);

})();
