(()=>{if(window.__TRADER_SHADIN_X_ACTIVE__)return console.warn("Trader Shadin X already running.");window.__TRADER_SHADIN_X_ACTIVE__=1;
const LOGO="data:image/webp;base64,",
KEY="trader_shadin_x_settings_v8",D={delaySec:0,direction:"random"};
let S={...D};try{S={...D,...JSON.parse(localStorage.getItem(KEY)||"{}")}}catch{}
S.delaySec=Math.max(0,Math.min(30,+S.delaySec||0));if(!["up","down","random"].includes(S.direction))S.direction="random";

const st=document.createElement("style");
st.textContent=`#tsx{position:fixed;z-index:2147483647;left:16px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:center;gap:4px;cursor:grab;user-select:none;touch-action:none;filter:drop-shadow(0 2px 5px #000)}#tsx img{width:38px;height:38px;border-radius:50%;object-fit:cover}#tsx b{font:700 10px system-ui;color:#fff;text-shadow:0 1px 3px #000}#ov{position:fixed;inset:0;z-index:2147483646;display:none;pointer-events:none}#ln{position:absolute;left:0;width:100%;height:5px;top:-8%;background:#14ad56;box-shadow:0 0 30px #00c864,0 0 70px #00a84f}#ov.on{display:block}#ln.go{animation:s 1.2s linear}@keyframes s{to{top:108%}}#bd{position:fixed;inset:0;z-index:2147483647;background:#0008;display:none}#p{position:fixed;z-index:2147483648;left:50%;top:50%;transform:translate(-50%,-50%);width:min(300px,calc(100vw - 32px));padding:16px;border-radius:14px;background:#100b16;color:#fff;border:1px solid #9400ff;display:none;font:14px system-ui}#p.on,#bd.on{display:block}#p h3{text-align:center;color:#b066ff;margin:0 0 14px}#p input,#p button{box-sizing:border-box;width:100%;padding:10px;margin:5px 0;border-radius:8px;border:1px solid #5d2780;background:#18101f;color:#fff}#p button.sel{border-color:#b066ff;background:#3b1654}`;
document.head.appendChild(st);

const ov=document.createElement("div");
ov.id="ov";
ov.innerHTML='<div id="ln"></div>';
document.body.appendChild(ov);

const ln=ov.querySelector("#ln");

const bd=document.createElement("div");
bd.id="bd";
document.body.appendChild(bd);

const p=document.createElement("div");
p.id="p";
p.innerHTML='<h3>Trader Shadin X Settings</h3><label>Start delay (seconds)</label><input id="d" type="number" min="0" max="30" step="1"><label>Trade direction</label><button data-x="up">Up</button><button data-x="down">Down</button><button data-x="random">Random</button><button id="save">Save</button>';
document.body.appendChild(p);

const w=document.createElement("div");
w.id="tsx";
w.innerHTML=`<img src="${LOGO}" draggable="false"><b>Trader Shadin X</b>`;
document.body.appendChild(w);

const d=p.querySelector("#d");
const bs=p.querySelectorAll("[data-x]");
let taps=0,last=0,timer,active=0,drag=0,moved=0,sx,sy,sl,stp,mt;

function ui(){
  d.value=S.delaySec;
  bs.forEach(b=>b.classList.toggle("sel",b.dataset.x==S.direction));
}

function close(){
  p.classList.remove("on");
  bd.classList.remove("on");
}

function save(){
  S.delaySec=Math.max(0,Math.min(30,Math.round(+d.value||0)));
  S.direction=[...bs].find(b=>b.classList.contains("sel"))?.dataset.x||"random";
  try{localStorage.setItem(KEY,JSON.stringify(S))}catch{}
  close();
  ui();
}

bs.forEach(b=>b.onclick=()=>{
  bs.forEach(x=>x.classList.remove("sel"));
  b.classList.add("sel");
});

p.querySelector("#save").onclick=save;
bd.onclick=close;
ui();

function buttons(){
  let r=document.getElementById("trade-button");
  return r?[r.querySelector("button.JQZcs"),r.querySelector("button.twQq3")]:[];
}

function trade(){
  let [u,dn]=buttons(),pool=[u,dn].filter(Boolean);
  let a=S.direction=="up"?u:S.direction=="down"?dn:pool[Math.floor(Math.random()*pool.length)];
  a?.click();
}

function stop(){
  active=0;
  ov.classList.remove("on");
  ln.classList.remove("go");
  clearTimeout(mt);
}

function start(){
  if(active)return;
  active=1;
  ov.classList.add("on");
  let n=0;
  mt=setTimeout(function f(){
    if(!active)return;
    if(n++<3){
      ln.classList.remove("go");
      void ln.offsetWidth;
      ln.classList.add("go");
      mt=setTimeout(f,1200);
    }else{
      trade();
      stop();
    }
  },S.delaySec*1000);
}

function tap(){
  if(p.classList.contains("on"))return;
  let n=Date.now();
  if(n-last>500)taps=0;
  last=n;
  taps++;
  clearTimeout(timer);
  if(taps>=3){
    taps=0;
    ui();
    p.classList.add("on");
    bd.classList.add("on");
  }else{
    timer=setTimeout(()=>{
      if(taps==1)(active?stop:start)();
      taps=0;
    },120);
  }
}

function pos(x,y){
  let r=w.getBoundingClientRect();
  let l=Math.max(0,Math.min(sl+x-sx,innerWidth-r.width));
  let t=Math.max(0,Math.min(stp+y-sy,innerHeight-r.height));
  w.style.left=l+"px";
  w.style.top=t+"px";
  w.style.transform="none";
}

w.onmousedown=e=>{
  drag=1;
  moved=0;
  sx=e.clientX;
  sy=e.clientY;
  let r=w.getBoundingClientRect();
  sl=r.left;
  stp=r.top;
};

document.onmousemove=e=>{
  if(drag){
    if(Math.abs(e.clientX-sx)>8||Math.abs(e.clientY-sy)>8)moved=1;
    pos(e.clientX,e.clientY);
  }
};

document.onmouseup=()=>{
  if(drag&&!moved)tap();
  drag=0;
};

w.ontouchstart=e=>{
  let t=e.touches[0];
  drag=1;
  moved=0;
  sx=t.clientX;
  sy=t.clientY;
  let r=w.getBoundingClientRect();
  sl=r.left;
  stp=r.top;
};

w.ontouchmove=e=>{
  if(drag){
    let t=e.touches[0];
    if(Math.abs(t.clientX-sx)>8||Math.abs(t.clientY-sy)>8)moved=1;
    pos(t.clientX,t.clientY);
  }
};

w.ontouchend=()=>{
  if(drag&&!moved)tap();
  drag=0;
};

window.__TRADER_SHADIN_X_STOP__=()=>{
  stop();
  w.remove();
  ov.remove();
  bd.remove();
  p.remove();
  st.remove();
  delete window.__TRADER_SHADIN_X_ACTIVE__;
  delete window.__TRADER_SHADIN_X_STOP__;
};

})(); 
